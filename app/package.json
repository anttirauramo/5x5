{
  "name": "FiveByFive",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "yarn prepare:assets && react-native run-android",
    "ios": "yarn prepare:assets && react-native run-ios",
    "prepare:assets": "node scripts/encrypt-solutions.js",
    "link:assets": "npx react-native-asset",
    "build:android:debug": "yarn prepare:assets && cd android && ./gradlew assembleDebug",
    "build:android:release": "yarn prepare:assets && cd android && ./gradlew assembleRelease",
    "build:ios:debug": "yarn prepare:assets && xcodebuild -workspace ios/FiveByFive.xcworkspace -scheme FiveByFive -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
    "build:ios:release": "yarn prepare:assets && xcodebuild -workspace ios/FiveByFive.xcworkspace -scheme FiveByFive -configuration Release -sdk iphoneos -derivedDataPath ios/build",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "rm -rf ios/build ios/Pods",
    "clean": "yarn clean:android && yarn clean:ios && rm -rf node_modules && yarn install",
    "pod:install": "cd ios && bundle exec pod install",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.0",
    "crypto-js": "^4.2.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-fs": "^2.20.0",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
